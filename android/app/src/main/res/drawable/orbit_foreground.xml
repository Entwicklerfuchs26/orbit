<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Orbit rings (tilted), drawn as thin strokes -->
    <group android:name="ring1" android:pivotX="54" android:pivotY="54" android:rotation="-22">
        <path
            android:pathData="M18,54 a36,18 0 1,0 72,0 a36,18 0 1,0 -72,0 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.2"
            android:strokeAlpha="0.85"
            android:fillColor="#00000000" />
        <!-- a dot travelling the orbit -->
        <path
            android:pathData="M85,54 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z"
            android:fillColor="#FFFFFFFF" />
    </group>

    <group android:name="ring2" android:pivotX="54" android:pivotY="54" android:rotation="40">
        <path
            android:pathData="M26,54 a28,14 0 1,0 56,0 a28,14 0 1,0 -56,0 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.45"
            android:fillColor="#00000000" />
    </group>

    <!-- Core planet -->
    <path
        android:pathData="M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="39" android:startY="39"
                android:endX="69" android:endY="69">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD8E4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- little gloss highlight -->
    <path
        android:pathData="M47,49 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z"
        android:fillColor="#FF3D63FF"
        android:fillAlpha="0.18" />
</vector>
